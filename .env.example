# -----------------------------------------------------------------------------
# Campus Market — environment template
# Copy to .env and fill in values. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CAMPUS_ID=

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/campus_market?schema=public
DIRECT_URL=

# Authentication
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Initial administrator bootstrap (used once, then remove or rotate)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Email
EMAIL_FROM=Campus Market <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# SMS (optional)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=campus-market

# Alternative storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Payments — Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:3000/api/v1/payments/callback

# Payments — Hubtel (optional adapter)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CALLBACK_URL=http://localhost:3000/api/webhooks/hubtel

# AI assistant (optional)
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MAX_REQUESTS_PER_USER_PER_DAY=50

# Rate limiting (optional in development)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Feature flags
FEATURE_AI_ASSISTANT=false
FEATURE_SMS=false
FEATURE_IMAGE_MODERATION=false
FEATURE_PERSONALIZATION=true
