# -----------------------------------------------------------------------------
# Campus Market — environment template
# Copy to .env and fill in values. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CAMPUS_ID=

# Database (PostgreSQL — Neon recommended)
# DATABASE_URL:          pooled connection (-pooler host).
# DATABASE_URL_UNPOOLED: direct connection. The runtime prefers this one because pooled
#                        connections are closed by the provider between requests; the client
#                        keeps sockets alive and retries transient failures.
# Neon's `neon deploy` / `neon env pull` writes both into .env automatically.
# Other hosts may provide DIRECT_URL instead of DATABASE_URL_UNPOOLED.
# Both must include ?sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-xxxxx-pooler.us-east-1.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxxx-xxxxx.us-east-1.aws.neon.tech:5432/neondb?sslmode=require

# Authentication
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Development seed (never used in production). Password for the seeded demo accounts.
SEED_SAMPLE_PASSWORD=

# Initial administrator bootstrap (used once, then remove or rotate)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Email
EMAIL_FROM=Campus Market <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# SMS (optional)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Object storage (Vercel Blob) — product photos and learning materials
BLOB_READ_WRITE_TOKEN=

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=campus-market

# Alternative storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Payments — Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:3000/api/v1/payments/callback

# Payments — Hubtel (optional adapter)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CALLBACK_URL=http://localhost:3000/api/webhooks/hubtel

# AI assistant (optional)
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MAX_REQUESTS_PER_USER_PER_DAY=50

# Distributed rate limiting (recommended in production).
# When configured, anonymous abuse endpoints fail closed while the store is unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled jobs (protects /api/v1/cron/expire-orders)
CRON_SECRET=

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Feature flags
FEATURE_AI_ASSISTANT=false
FEATURE_SMS=false
FEATURE_IMAGE_MODERATION=false
FEATURE_PERSONALIZATION=true
